{
  "name": "data.mcky.space",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "api"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:full": "npm run typecheck && vite build",
    "build:functions": "echo 'functions/ removed — Pages does not use Workers Functions'",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint:jsx-nesting": "node scripts/lint-jsx-nesting.mjs",
    "lint": "npm run typecheck && npm run lint:jsx-nesting",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev ./dist -- npm run dev",
    "deploy": "npm run build && npm run wrangler -- pages deploy ./dist --project-name data-mcky-space --branch main",
    "wrangler": "env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID wrangler",
    "test": "vitest",
    "test:run": "vitest run",
    "check:pwa": "node scripts/check-pwa.mjs",
    "measure:perf": "node scripts/measure-perf.mjs",
    "generate:offline-map-styles": "node scripts/generate-offline-map-styles.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/localizations": "^4.15.4",
    "@elysiajs/eden": "^1.4.9",
    "@phosphor-icons/react": "^2.1.10",
    "@protomaps/basemaps": "^5.7.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@uiw/react-color": "^2.10.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "motion": "^12.42.2",
    "open-location-code": "^1.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-error-boundary": "^6.1.5",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^6.2.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.0.0"
  }
}
