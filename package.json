{
  "name": "data.mcky.space",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "api"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:full": "npm run typecheck && vite build",
    "build:functions": "echo 'functions/ removed — Pages does not use Workers Functions'",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint:jsx-nesting": "node scripts/lint-jsx-nesting.mjs",
    "lint": "npm run typecheck && npm run lint:jsx-nesting",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev ./dist -- npm run dev",
    "deploy": "npm run build && npm run wrangler -- pages deploy ./dist --project-name data-mcky-space --branch main",
    "wrangler": "env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID wrangler",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.1",
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/localizations": "^4.15.4",
    "@elysiajs/eden": "^1.4.9",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.42.2",
    "open-location-code": "^1.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.6.0",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0"
  }
}
