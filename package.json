{
  "name": "data.mcky.space",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "api"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:full": "npm run typecheck && vite build",
    "build:functions": "echo 'functions/ removed — Pages does not use Workers Functions'",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json",
    "lint:jsx-nesting": "node scripts/lint-jsx-nesting.mjs",
    "lint": "npm run typecheck && npm run lint:jsx-nesting",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev ./dist -- npm run dev",
    "deploy": "npm run build && npm run wrangler -- pages deploy ./dist --project-name data-mcky-space --branch main",
    "wrangler": "env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID wrangler",
    "test": "vitest",
    "test:run": "vitest run",
    "check:pwa": "node scripts/check-pwa.mjs",
    "measure:perf": "node scripts/measure-perf.mjs",
    "generate:offline-map-styles": "node scripts/generate-offline-map-styles.mjs"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@protomaps/basemaps": "^5.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "open-location-code": "^1.0.3",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^6.2.2",
    "@clerk/clerk-js": "^5.0.0",
    "@tanstack/svelte-virtual": "^3.13.0",
    "svelte-spa-router": "^4.0.1",
    "svelte": "^5.46.4",
    "phosphor-svelte": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/leaflet": "^1.9.22",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.0.0"
  }
}
